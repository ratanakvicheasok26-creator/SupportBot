# ===============================================
# Telegram Customer Bot Configuration
# ===============================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# 2. Your Telegram Admin ID (e.g. 1217328195) OR Supergroup ID (e.g., -1001234567890)
ADMIN_CHAT_ID=1217328195

# 2.1 (Optional) If using a Telegram Supergroup with Forum Topics, specify the dedicated Topic ID here:
# (Type /id inside your desired topic to get the exact ID)
ADMIN_TOPIC_ID=0

# 3. Google Gemini API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your_gemini_api_key_here"

# 4. Default fallback message if AI key is not provided
DEFAULT_AUTO_REPLY="Hey! 👋 Thanks for reaching out. How can I help you today?"

# 5. Auto-reply frequency mode: 'always' (AI answers all questions), 'first_time', or 'disabled'
AUTO_REPLY_MODE=always
